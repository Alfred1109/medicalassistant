<view class="page">
  <view class="heading"><view class="title">随访安排</view><view class="subtitle">查看康复团队为你安排的联系和复诊计划。</view></view>
  <view wx:if="{{loading && !loaded}}" class="state">正在读取随访安排…</view>
  <view wx:elif="{{error}}" class="state error"><view>{{error}}</view><button class="retry" bindtap="loadFollowups">重试</button></view>
  <view wx:elif="{{loaded && followups.length === 0}}" class="state">目前没有随访安排。</view>
  <view wx:for="{{followups}}" wx:key="id" class="card">
    <view class="row"><view class="type">{{item.type_label}}随访</view><view class="status">{{item.status_label}}</view></view>
    <view class="scheduled">计划时间：{{item.scheduled_date}}</view>
    <view wx:if="{{item.description}}" class="body">{{item.description}}</view>
    <view wx:if="{{item.actual_date}}" class="meta">实际随访时间：{{item.actual_date}}</view>
    <view wx:if="{{item.followup_summary.conclusion}}" class="summary"><view class="label">随访小结</view>{{item.followup_summary.conclusion}}</view>
    <view wx:if="{{item.followup_summary.next_plan_suggestion}}" class="summary"><view class="label">后续建议</view>{{item.followup_summary.next_plan_suggestion}}</view>
    <view wx:if="{{item.notes}}" class="summary"><view class="label">记录</view>{{item.notes}}</view>
  </view>
  <view wx:if="{{hasMore}}" class="load-more"><view wx:if="{{moreError}}" class="error-text">{{moreError}}</view><button loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="loadMore">加载更多</button></view>
  <view wx:if="{{loading && loaded}}" class="footnote">正在刷新…</view>
</view>
<role-nav current="health" />
