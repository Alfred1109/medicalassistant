<view class="page">
  <view class="heading"><view class="title">康复方案</view><view class="subtitle">这里只显示医护已发布并确认的方案。</view></view>
  <view wx:if="{{loading && !loaded}}" class="state">正在读取康复方案…</view>
  <view wx:elif="{{error}}" class="state error"><view>{{error}}</view><button class="retry" bindtap="loadPlans">重试</button></view>
  <view wx:elif="{{loaded && plans.length === 0}}" class="state">目前没有可查看的已发布康复方案。</view>
  <view wx:for="{{plans}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="openPlan">
    <view class="plan-name">{{item.content.name}}</view>
    <view class="description">{{item.content.goal}}</view>
    <view class="meta">开始：{{item.content.start_date}}</view>
    <view wx:if="{{item.content.end_date}}" class="meta">结束：{{item.content.end_date}}</view>
    <view class="meta">处方项目 {{item.items.length}} 项</view>
    <view class="open">查看方案与执行反馈　›</view>
  </view>
  <view wx:if="{{hasMore}}" class="load-more"><view wx:if="{{moreError}}" class="error-text">{{moreError}}</view><button loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="loadMore">加载更多</button></view>
  <view wx:if="{{loading && loaded}}" class="footnote">正在刷新…</view>
</view>
<role-nav current="plans" />
