<view class="page">
  <view class="heading"><view class="title">知情同意</view><view class="subtitle">阅读医护发给你的文件，并按你的意愿回应。</view></view>
  <view wx:if="{{loading && !loaded}}" class="state">正在读取知情同意文件…</view>
  <view wx:elif="{{error}}" class="state error"><view>{{error}}</view><button class="retry" bindtap="loadDocuments">重试</button></view>
  <view wx:elif="{{loaded && documents.length === 0}}" class="state">目前没有发给你的知情同意文件。</view>
  <view wx:for="{{documents}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="openDocument">
    <view class="row"><view class="doc-title">{{item.title}}</view><view class="status">{{item.status_label}}</view></view>
    <view class="body-preview">{{item.body}}</view>
    <view wx:if="{{item.signed_at}}" class="meta">记录时间：{{item.signed_at}}</view>
    <view class="open">阅读全文　›</view>
  </view>
  <view wx:if="{{loading && loaded}}" class="footnote">正在刷新…</view>
</view>
<role-nav current="profile" />
