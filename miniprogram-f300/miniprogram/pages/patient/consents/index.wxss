.page { min-height: 100vh; padding: 30rpx 26rpx 60rpx; background: #f4f7fb; box-sizing: border-box; }
.heading { padding: 14rpx 8rpx 22rpx; }
.title { color: #173344; font-size: 40rpx; font-weight: 700; }
.subtitle { margin-top: 12rpx; color: #75838c; font-size: 24rpx; }
.card, .state { margin: 18rpx 0; padding: 28rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(31, 59, 82, .05); }
.row { display: flex; justify-content: space-between; align-items: flex-start; gap: 12rpx; }
.doc-title { color: #203b4a; font-size: 28rpx; font-weight: 650; }
.status { flex: none; padding: 8rpx 14rpx; border-radius: 24rpx; background: #edf5f3; color: #39736b; font-size: 20rpx; }
.body-preview { display: -webkit-box; overflow: hidden; margin-top: 16rpx; color: #647782; font-size: 23rpx; line-height: 1.5; -webkit-line-clamp: 3; -webkit-box-orient: vertical; }
.meta { margin-top: 12rpx; color: #81909a; font-size: 21rpx; }
.open { margin-top: 18rpx; color: #176f65; font-size: 23rpx; font-weight: 600; }
.state { color: #71808a; font-size: 25rpx; line-height: 1.6; }
.error { color: #a13e3e; }
.retry { margin: 20rpx 0 0; color: #17695f; background: #e8f3f1; font-size: 24rpx; }
.footnote { padding: 18rpx; color: #829099; text-align: center; font-size: 22rpx; }
