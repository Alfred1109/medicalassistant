<view class="page">
  <view wx:if="{{loading && !loaded}}" class="state">正在读取方案…</view>
  <view wx:elif="{{error}}" class="state error"><view>{{error}}</view><button class="retry" bindtap="loadPlan">重试</button></view>
  <block wx:elif="{{plan}}">
    <view class="hero"><view class="title">{{plan.content.name}}</view><view class="goal">{{plan.content.goal}}</view><view class="meta">发布于 {{plan.published_at}}</view></view>
    <view class="card">
      <view class="section-title">方案安排</view>
      <view class="body">{{plan.content.description}}</view>
      <view wx:if="{{plan.content.patient_instructions}}" class="instructions"><view class="label">医护说明</view>{{plan.content.patient_instructions}}</view>
      <view class="meta">起始日期：{{plan.content.start_date}}</view>
      <view wx:if="{{plan.content.end_date}}" class="meta">结束日期：{{plan.content.end_date}}</view>
      <view wx:if="{{plan.content.frequency}}" class="meta">频次：{{plan.content.frequency}}</view>
    </view>
    <view class="card">
      <view class="section-title">处方内容（{{plan.items.length}} 项）</view>
      <view wx:if="{{!plan.items.length}}" class="empty">此方案暂无处方项目。</view>
      <view wx:for="{{plan.items}}" wx:key="item_id" class="item">
        <view class="item-name">{{item.name}}</view>
        <view class="tag">{{item.intervention_type}}</view>
        <view wx:if="{{item.description}}" class="body">{{item.description}}</view>
        <view wx:if="{{item.patient_instructions}}" class="instructions">{{item.patient_instructions}}</view>
        <view wx:for="{{item.execution_requirements}}" wx:for-item="requirement" wx:key="index" class="requirement">· {{requirement}}</view>
        <view wx:if="{{item.schedule.sets || item.schedule.reps || item.schedule.duration_minutes}}" class="meta">训练安排：{{item.schedule.sets}} 组　{{item.schedule.reps}} 次　{{item.schedule.duration_minutes}} 分钟</view>
        <video wx:if="{{item.guidance_video_url}}" class="video" src="{{item.guidance_video_url}}" controls show-center-play-btn="true" />
      </view>
    </view>
    <view class="card">
      <view class="section-title">训练周期与验收</view>
      <view wx:if="{{cycleLoading && !trainingCycles.length}}" class="state">正在读取训练周期…</view>
      <view wx:if="{{cycleError}}" class="inline-error">{{cycleError}} <button class="retry" bindtap="loadTrainingCycles">重试</button></view>
      <view wx:if="{{!cycleLoading && !cycleError && !trainingCycles.length}}" class="empty">医护还没有为此方案设置训练周期。</view>
      <view wx:for="{{trainingCycles}}" wx:key="id" class="cycle-item">
        <view class="item-name">{{item.title}}</view>
        <view class="meta">周期：{{item.start_date}} 至 {{item.end_date}}</view>
        <view class="meta">周期状态：{{item.status === 'accepted' ? '已统一验收' : '尚未验收'}}</view>
        <view wx:if="{{item.status === 'accepted' && item.acceptance}}" class="body">
          <view>验收时间：{{item.acceptance.accepted_at}}</view>
          <view wx:if="{{item.acceptance.note}}">验收意见：{{item.acceptance.note}}</view>
        </view>
        <view class="meta">训练视频：{{item.verified_count}} 条已核验，{{item.pending_reviews_count}} 条待核验</view>
      </view>
    </view>
    <view class="card">
      <view class="section-title">执行反馈</view>
      <view class="hint">记录你对当前方案的实际执行情况，医护可据此了解反馈。自我报告不代表系统已核验训练完成。</view>
      <picker wx:if="{{plan.items.length}}" range="{{plan.items}}" range-key="name" value="{{selectedItemIndex}}" bindchange="onItemChange"><view class="picker">处方项目：{{plan.items[selectedItemIndex].name}}</view></picker>
      <picker range="{{statusOptions}}" value="{{selectedStatusIndex}}" bindchange="onStatusChange"><view class="picker">执行情况：{{statusOptions[selectedStatusIndex]}}</view></picker>
      <textarea class="textarea" maxlength="2000" placeholder="记录本次执行感受" value="{{feelings}}" bindinput="onFeelingsInput" />
      <view wx:if="{{plan.items[selectedItemIndex].intervention_type === 'exercise' && statusValues[selectedStatusIndex] !== 'not_done'}}" class="video-upload">
        <view class="hint">训练项目选择“已完成”或“部分完成”时，请上传 MP4 或 WebM 视频（最大 20 MB），供医护核验。</view>
        <button class="retry" disabled="{{submitting}}" bindtap="chooseTrainingVideo">{{selectedVideoName ? '重新选择训练视频' : '选择训练视频'}}</button>
        <view wx:if="{{selectedVideoName}}" class="meta">已选择：{{selectedVideoName}}</view>
      </view>
      <button class="primary" loading="{{submitting}}" disabled="{{submitting || !plan.items.length}}" bindtap="submitFeedback">提交执行反馈</button>
      <view wx:if="{{feedbackError}}" class="inline-error">{{feedbackError}}</view>
      <view class="subheading">历史反馈</view>
      <view wx:if="{{!feedbackError && !feedback.length}}" class="empty">目前没有这版方案的执行反馈。</view>
      <view wx:for="{{feedback}}" wx:key="id" class="feedback-item">
        <view class="row"><view>{{item.statusLabel}}</view><view class="meta">{{item.performed_at}}</view></view>
        <view class="body">{{item.feelings}}</view>
        <view wx:if="{{item.needsTrainingReview}}" class="meta">训练视频核验：{{item.reviewStatusLabel}}</view>
        <view wx:if="{{item.needsTrainingReview && item.clinical_review.note}}" class="body">医护意见：{{item.clinical_review.note}}</view>
        <view wx:if="{{item.needsTrainingReview}}" wx:for="{{item.supplements}}" wx:for-item="supplement" wx:key="id" class="supplement-history">
          <view class="meta">补充时间：{{supplement.submitted_at}}</view>
          <view class="body">补充说明：{{supplement.note}}</view>
          <view wx:if="{{supplement.attachmentNames}}" class="meta">附件：{{supplement.attachmentNames}}</view>
        </view>
        <view wx:if="{{item.needsTrainingReview && item.clinical_review.status === 'return_for_supplement'}}" class="supplement-box">
          <view class="hint">请按医护意见补充训练视频和说明。</view>
          <button class="retry" disabled="{{item.supplementSubmitting}}" data-index="{{index}}" bindtap="chooseSupplementVideo">{{item.supplementVideoName ? '重新选择补充视频' : '选择补充视频'}}</button>
          <view wx:if="{{item.supplementVideoName}}" class="meta">已选择：{{item.supplementVideoName}}</view>
          <textarea class="textarea" maxlength="1000" placeholder="说明补充内容" value="{{item.supplementNote}}" data-index="{{index}}" bindinput="onSupplementNoteInput" />
          <button class="primary" loading="{{item.supplementSubmitting}}" disabled="{{item.supplementSubmitting}}" data-index="{{index}}" bindtap="submitSupplement">提交补充材料</button>
          <view wx:if="{{item.supplementError}}" class="inline-error">{{item.supplementError}}</view>
        </view>
      </view>
      <button wx:if="{{feedbackHasMore}}" class="retry" loading="{{feedbackLoading}}" disabled="{{feedbackLoading}}" bindtap="loadMoreFeedback">加载更多反馈</button>
    </view>
  </block>
</view>
<role-nav current="plans" />
