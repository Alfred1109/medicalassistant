.page { padding: 32rpx 28rpx 140rpx; background: #f4f6f8; min-height: 100vh; box-sizing: border-box; }
.title { font-size: 42rpx; font-weight: 700; color: #172b35; }
.muted { color: #61747c; font-size: 26rpx; margin-top: 14rpx; }
.card { background: #fff; border-radius: 22rpx; padding: 28rpx; margin-top: 22rpx; }
.task-title { font-size: 32rpx; font-weight: 600; }
.error { color: #ad3232; margin-top: 20rpx; }
.primary { background: #116b63; color: white; margin-top: 24rpx; }
