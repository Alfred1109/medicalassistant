<view class="page">
  <view class="hero">
    <view class="eyebrow">REHABMAN · 患者服务</view>
    <view class="title">你好，{{userName}}</view>
    <view class="subtitle">查看康复安排、记录身体变化，并与医护保持同步。</view>
  </view>
  <view wx:if="{{error}}" class="state error">{{error}}</view>
  <view wx:else class="sections">
    <view class="capture-card" bindtap="openCapture"><view class="capture-title">连接 F300 手环</view><view class="capture-description">进入设备采集页面，同步本次心率读数</view><view class="capture-arrow">进入　›</view></view>
    <view class="data-section">
      <view class="section-heading">健康指标</view>
      <view wx:if="{{metricsLoading && !metricsLoaded}}" class="mini-state">正在读取健康指标…</view>
      <view wx:elif="{{metricsError}}" class="mini-state error">{{metricsError}}<button class="retry" data-block="metrics" bindtap="retryBlock">重试</button></view>
      <view wx:elif="{{metricsLoaded && !metrics.length}}" class="mini-state">暂无健康指标数据。</view>
      <view wx:for="{{metrics}}" wx:key="id" class="data-row">
        <view class="data-row-top"><view class="data-name">{{item.name || item.type || '未命名指标'}}</view><view class="data-value">{{item.value === null || item.value === undefined ? '—' : item.value}} {{item.unit}}</view></view>
        <view class="data-meta">{{item.timestamp}}</view>
        <view wx:if="{{item.quality_flags.length}}" class="quality">数据质量标记：{{item.quality_flags}}</view>
      </view>
    </view>
    <view class="data-section">
      <view class="section-heading">待办事项</view>
      <view wx:if="{{todoLoading && !todoLoaded}}" class="mini-state">正在读取待办事项…</view>
      <view wx:elif="{{todoError}}" class="mini-state error">{{todoError}}<button class="retry" data-block="todos" bindtap="retryBlock">重试</button></view>
      <view wx:elif="{{todoLoaded && !todos.length}}" class="mini-state">目前没有待办事项。</view>
      <view wx:for="{{todos}}" wx:key="id" class="todo-row">
        <view class="todo-title">{{item.title || '待办事项'}}</view>
        <view wx:if="{{item.description}}" class="data-meta">{{item.description}}</view>
        <view wx:if="{{item.due}}" class="data-meta">截止：{{item.due}}</view>
        <view wx:if="{{item.completed === true}}" class="todo-status">已完成</view>
      </view>
    </view>
    <view class="data-section">
      <view class="section-heading">已发布康复方案</view>
      <view wx:if="{{plansLoading && !plansLoaded}}" class="mini-state">正在读取方案…</view>
      <view wx:elif="{{plansError}}" class="mini-state error">{{plansError}}<button class="retry" data-block="plans" bindtap="retryBlock">重试</button></view>
      <view wx:elif="{{plansLoaded && !plans.length}}" class="mini-state">目前没有已发布康复方案。</view>
      <view wx:for="{{plans}}" wx:key="id" class="plan-row" data-id="{{item.id}}" bindtap="openPlan">
        <view class="todo-title">{{item.content.name}}</view>
        <view class="data-meta">{{item.content.goal}}</view>
        <view class="data-meta">处方项目 {{item.items.length}} 项</view>
      </view>
      <view class="more" bindtap="openSection" data-key="plans">查看全部方案　›</view>
    </view>
    <view wx:for="{{sections}}" wx:key="key" class="section-card" data-key="{{item.key}}" bindtap="openSection">
      <view class="section-copy"><view class="section-title">{{item.title}}</view><view class="section-description">{{item.description}}</view></view>
      <view class="arrow">›</view>
    </view>
  </view>
  <view class="footnote">康复指导和健康信息用于日常管理，请按医护人员为你确认的方案执行。</view>
</view>
<role-nav current="home" />
