.page { min-height: 100vh; padding: 30rpx 26rpx 60rpx; background: #f4f7fb; box-sizing: border-box; }
.heading { padding: 14rpx 8rpx 22rpx; }
.title { color: #173344; font-size: 40rpx; font-weight: 700; }
.subtitle { margin-top: 12rpx; color: #75838c; font-size: 24rpx; }
.card, .state { margin: 18rpx 0; padding: 28rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(31, 59, 82, .05); }
.section-title, .section-heading { color: #173344; font-size: 29rpx; font-weight: 650; }
.section-heading { margin: 30rpx 8rpx 12rpx; }
.label { margin: 18rpx 0 8rpx; color: #60737d; font-size: 23rpx; }
.field, .textarea { box-sizing: border-box; width: 100%; margin-top: 10rpx; padding: 20rpx; border-radius: 12rpx; background: #f4f7f8; color: #405762; font-size: 25rpx; }
.textarea { min-height: 130rpx; }
.switch-row, .row { display: flex; align-items: center; justify-content: space-between; }
.switch-row { margin: 22rpx 0; color: #405762; font-size: 24rpx; }
.primary { margin-top: 20rpx; color: #fff; background: #17766a; font-size: 26rpx; }
.secondary { margin-top: 16rpx; color: #17695f; background: #e8f3f1; font-size: 24rpx; }
.record-actions { display: flex; gap: 16rpx; margin-top: 18rpx; }
.record-actions button { flex: 1; margin: 0; font-size: 23rpx; }
.delete { color: #a13e3e; background: #f9ecec; }
.record-date { color: #203b4a; font-size: 27rpx; font-weight: 650; }
.pain { color: #56736e; font-size: 23rpx; }
.meta { margin-top: 12rpx; color: #74848d; font-size: 23rpx; }
.note { margin-top: 16rpx; color: #4d626f; font-size: 24rpx; line-height: 1.5; white-space: pre-wrap; }
.state { color: #71808a; font-size: 25rpx; line-height: 1.6; }
.error, .load-error { color: #a13e3e; font-size: 23rpx; line-height: 1.5; }
.success { margin-top: 16rpx; color: #17766a; font-size: 23rpx; }
.retry { margin-top: 14rpx; background: #e8f3f1; color: #17695f; font-size: 23rpx; }
