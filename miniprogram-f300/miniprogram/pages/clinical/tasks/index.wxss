.page { padding: 24rpx; color: #263746; }
.header,.task-head { display: flex; justify-content: space-between; align-items: center; gap: 14rpx; }
.header { padding: 18rpx 8rpx 28rpx; }
.title { font-size: 36rpx; font-weight: 700; }
.muted { color: #74818b; font-size: 23rpx; line-height: 1.6; overflow-wrap: anywhere; }
.card { background: #fff; border-radius: 18rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: 0 4rpx 18rpx rgba(29,54,78,.06); }
.task-title { font-size: 28rpx; font-weight: 600; }
.status { border-radius: 20rpx; padding: 6rpx 14rpx; background: #eaf2ff; color: #145fc2; font-size: 22rpx; }
.actions { display: flex; gap: 12rpx; flex-wrap: wrap; margin-top: 14rpx; }
button { font-size: 24rpx; margin: 0; }
button.primary { background: #1677ff; color: #fff; }
button.secondary { background: #eaf2ff; color: #145fc2; }
button.danger { background: #fff0ef; color: #a93028; }
button.small { font-size: 22rpx; line-height: 1.9; padding: 0 18rpx; }
button.more { width: 100%; margin: 12rpx 0; }
.notice { border-radius: 12rpx; background: #fff8df; color: #805d12; padding: 16rpx; margin: 12rpx 0; font-size: 23rpx; line-height: 1.5; }
.notice.error { background: #fff0ef; color: #aa332b; }
.notice.success { background: #eaf8ef; color: #207345; }
.empty { color: #82909b; text-align: center; padding: 36rpx 10rpx; font-size: 25rpx; }
.modal-mask { position: fixed; inset: 0; z-index: 10; display: flex; align-items: center; justify-content: center; padding: 24rpx; background: rgba(14,28,40,.48); }
.modal { width: 100%; max-height: 88vh; overflow-y: auto; border-radius: 20rpx; background: #fff; padding: 28rpx; box-sizing: border-box; }
.picker { box-sizing: border-box; width: 100%; padding: 20rpx 16rpx; border: 1rpx solid #dfe6ec; border-radius: 10rpx; margin: 14rpx 0; font-size: 24rpx; overflow-wrap: anywhere; }
