.page { padding: 24rpx; min-height: 100vh; box-sizing: border-box; }
.header { display: flex; justify-content: space-between; align-items: center; margin: 4rpx 0 22rpx; }
.title { font-size: 40rpx; font-weight: 700; color: #1c2b39; }
.subtitle { color: #788591; font-size: 23rpx; margin-top: 8rpx; }
.refresh { margin: 0; padding: 0 20rpx; line-height: 2; font-size: 24rpx; color: #1768c4; background: #eaf3ff; }
.layout { display: flex; flex-direction: column; gap: 18rpx; }
.list-card, .chat-card { background: #fff; border-radius: 18rpx; box-shadow: 0 6rpx 22rpx rgba(24, 43, 61, .05); overflow: hidden; }
.list-heading, .chat-heading { padding: 22rpx 24rpx; border-bottom: 1rpx solid #edf0f2; font-size: 29rpx; font-weight: 650; }
.list-heading { display: flex; align-items: center; justify-content: space-between; }
.list-title { display: flex; align-items: center; gap: 12rpx; }
.new-chat { margin: 0; padding: 0 16rpx; line-height: 1.8; font-size: 22rpx; color: #1768c4; background: #eaf3ff; }
.count { font-size: 22rpx; color: #7a8792; font-weight: 400; }
.conversation-list { max-height: 420rpx; overflow-y: auto; }
.older { margin: 14rpx auto; font-size: 22rpx; color: #1768c4; background: #eef6ff; }
.conversation { padding: 22rpx 24rpx; border-bottom: 1rpx solid #f0f2f4; }
.conversation.selected { background: #eef6ff; }
.conversation-top { display: flex; justify-content: space-between; align-items: center; }
.name { font-size: 27rpx; font-weight: 600; color: #243746; }
.preview { margin-top: 10rpx; color: #7b8791; font-size: 23rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.read-only-label { margin-top: 8rpx; color: #9a6b1c; font-size: 21rpx; }
.badge { min-width: 34rpx; padding: 1rpx 9rpx; border-radius: 20rpx; color: white; background: #1677ff; font-size: 20rpx; text-align: center; }
.empty { padding: 42rpx 28rpx; text-align: center; color: #85919a; font-size: 25rpx; line-height: 1.6; }
.muted { color: #89949e; font-size: 22rpx; line-height: 1.5; }
.contact-button { margin-top: 20rpx; font-size: 23rpx; color: #1768c4; background: #eaf3ff; }
.secondary { margin: 16rpx 0 0; font-size: 23rpx; color: #1768c4; background: #eaf3ff; }
.modal-mask { position: fixed; z-index: 50; inset: 0; display: flex; align-items: center; justify-content: center; padding: 28rpx; background: rgba(21, 34, 47, .42); }
.contact-modal { width: 100%; max-width: 680rpx; max-height: 78vh; overflow-y: auto; padding: 26rpx; box-sizing: border-box; border-radius: 18rpx; background: #fff; }
.modal-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; font-size: 31rpx; font-weight: 650; }
.close { font-size: 23rpx; color: #1768c4; font-weight: 400; }
.contact-list { margin-top: 12rpx; }
.contact-row { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #edf0f2; }
.contact-start { margin: 0; padding: 0 14rpx; font-size: 21rpx; color: #fff; background: #1677ff; }
.chat-heading { display: flex; justify-content: space-between; align-items: center; }
.messages { height: 600rpx; padding: 16rpx 20rpx; box-sizing: border-box; }
.message-row { display: flex; justify-content: flex-start; margin: 14rpx 0; }
.message-row.mine { justify-content: flex-end; }
.bubble { max-width: 82%; padding: 16rpx 19rpx; border-radius: 16rpx 16rpx 16rpx 4rpx; background: #f1f4f7; }
.mine-bubble { color: #fff; background: #1677ff; border-radius: 16rpx 16rpx 4rpx 16rpx; }
.message-content { white-space: pre-wrap; word-break: break-all; font-size: 25rpx; line-height: 1.55; }
.timestamp { margin-top: 8rpx; opacity: .7; font-size: 18rpx; text-align: right; }
.composer { display: flex; align-items: flex-end; gap: 12rpx; padding: 16rpx; border-top: 1rpx solid #edf0f2; }
.read-only-notice { padding: 20rpx 22rpx; border-top: 1rpx solid #edf0f2; color: #805d12; background: #fff8df; font-size: 23rpx; line-height: 1.5; }
.input { flex: 1; min-height: 70rpx; max-height: 180rpx; padding: 14rpx; box-sizing: border-box; background: #f3f5f7; border-radius: 12rpx; font-size: 25rpx; }
.send { width: 112rpx; padding: 0; margin: 0; color: #fff; background: #1677ff; font-size: 25rpx; }
.notice { padding: 18rpx 20rpx; margin: 10rpx 0 18rpx; border-radius: 12rpx; color: #805d12; background: #fff8df; font-size: 23rpx; line-height: 1.5; }
.error { color: #a12d27; background: #fff0ef; }
.error-text, .inline-error { color: #a12d27; }
.inline-error { padding: 10rpx; text-align: center; font-size: 22rpx; }
.footnote { padding: 20rpx 8rpx 6rpx; color: #89939c; font-size: 21rpx; line-height: 1.5; }
@media (min-width: 700px) {
  .page { max-width: 1100rpx; margin: 0 auto; }
  .layout { flex-direction: row; align-items: stretch; }
  .list-card { width: 36%; }
  .chat-card { flex: 1; }
  .conversation-list { max-height: 760rpx; }
  .messages { height: 700rpx; }
}
